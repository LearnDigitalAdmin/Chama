+            "amount": new_total,
             "date": today,
             "method": "manual",
             "createdAt": ts,
@@ -305,20 +357,20 @@ def recordCashMgrPayment(req: https_fn.CallableRequest) -> dict:
     db.collection(paths.transactions(chama_id)).document().set({
         "type": "mgr_contribution",
         "memberId": member_id,
-        "amount": use_amount,
+        "amount": pay_amount,
         "method": "manual",
         "ref": "CASH" + str(ts)[-8:],
         "date": today,
         "settled": False,
         "direction": "in",
         "channel": "app",
-        "note": pot["name"],
+        "note": pot["name"] + (" (partial)" if new_status == "partial" else ""),
         "potId": pot_id,
