     records = _all_records(db, chama_id, pot_id)
     queue = pot["queue"]
@@ -479,6 +543,7 @@ def recordMgrPayoutCash(req: https_fn.CallableRequest) -> dict:
         batch.set(payout_ref, {
             "memberId": member_id,
             "round": round_no,
