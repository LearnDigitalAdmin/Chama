+                        // dashboard's Group balance is seeded from (see
+                        // AdminDashboard.tsx). Nothing else may ride along
+                        // on this write.
+                        isTreasurer(chamaId)
+                        && onlyChanged(['openingBalance', 'updatedAt'])
+                        && isNumber(request.resource.data.openingBalance)
+                        && request.resource.data.openingBalance >= 0
+                      );
 
       allow delete: if false;
 
