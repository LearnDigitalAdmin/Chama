+    assert [v["name"] for v in res["valid"]] == ["A", "D"]
+    assert {(e["row"], e["field"]) for e in res["errors"]} == {(2, "idNumber"), (3, "idNumber")}
+
+
+def test_desk_commit_takes_a_lock_per_member_and_blocks_a_second_import(db):
+    d = desk_db()
