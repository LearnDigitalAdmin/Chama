+    _, first = call(d, "commit_records", {"rows": rows, "source": "excel"}, rid="commit-0001")
+    assert first["result"]["created"] == 1 and lock_path("c1", "12345678") in d.store
+    again = [{"name": "A2", "phone": "0722000077", "idNumber": "12345678"}]
