+
+
+def member_id_key(chama_id: str, id_key: str) -> str:
+    return f"{MC.CHAMAS}/{chama_id}/{MEMBER_ID_KEYS}/{id_key}"
+
+
 def loan_products(chama_id: str) -> str:
     return f"{MC.CHAMAS}/{chama_id}/{MC.LOAN_PRODUCTS}"
 
