diff --git a/tools/brand/package.json b/tools/brand/package.json
new file mode 100644
index 0000000..4fcab88
--- /dev/null
+++ b/tools/brand/package.json
@@ -0,0 +1,18 @@
+{
+  "name": "samuhia-brand-tool",
+  "version": "1.0.0",
+  "private": true,
+  "type": "module",
+  "description": "Turns the SAMUHIA Logo Studio HTML into every favicon, PWA icon, splash screen and OG image a product site needs.",
+  "scripts": {
+    "brand:mychama": "node apply-brand.mjs --brand mychama",
+    "brand:myregister": "node apply-brand.mjs --brand myregister",
+    "brand:list": "node apply-brand.mjs --list"
+  },
+  "dependencies": {
+    "sharp": "^0.34.0"
+  },
+  "engines": {
+    "node": ">=18.17"
+  }
+}
diff --git a/tools/brand/samuhia-site-logo-studio.html b/tools/brand/samuhia-site-logo-studio.html
