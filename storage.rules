rules_version = '2';

// ============================================================================
// MyChama — Cloud Storage Security Rules (project: mychama1)
//
// Nothing in this bucket is written by a client. Statements and minutes
// PDFs (Phase 4 — functions/mychama/billing.py::generateStatement) are
// written by the Admin SDK, which bypasses these rules entirely, and are
// handed to the person as a short-lived (48h) v4 signed URL rather than a
// world-readable path — so direct client access to the bucket, in either
// direction, is never needed and is denied outright below.
//
// This replaces the default `firebase init` placeholder rule (open to
// everyone until an expiry date), which was still in place before this
// pass — flagged as a real pre-launch fix in TOUCH_BASE.md.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
